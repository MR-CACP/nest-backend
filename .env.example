# 复制本文件为 .env 并按需修改：cp .env.example .env
# 安全须知：敏感信息请勿提交到版本库，可放入 .env.*.local（已被 .gitignore 忽略）
# 或通过部署平台的环境变量注入（process.env 优先级高于所有 .env 文件）

# 注意：不要在此文件设置 NODE_ENV——加载哪些 env 文件取决于该变量（循环依赖），
# 必须由进程环境注入（package.json scripts 已用 cross-env，生产由部署平台注入）

# 应用监听端口
PORT=3000

# 反向代理可信层数：无代理直连部署保持 false（默认，安全）；
# 只有真实多层代理时才设为对应层数
TRUST_PROXY=false

# 全局路由前缀，所有接口都在该前缀下访问（如 /api/xxx）
API_PREFIX=api

# 日志级别：fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# 是否启用 Swagger 文档（默认关闭；生产环境强制禁止开启）
SWAGGER_ENABLED=false

# Swagger 文档访问路径
SWAGGER_PATH=docs

# 限速时间窗口（秒）
THROTTLE_TTL=60

# 时间窗口内允许的最大请求数
THROTTLE_LIMIT=100

# CORS 允许来源：* 或逗号分隔的域名列表（如 https://a.com,https://b.com）
CORS_ORIGIN=*

# 是否允许跨域携带凭证（cookie 等）
CORS_CREDENTIALS=false

# ---------- 限速计数存储 ----------
# memory 单进程内存（多副本部署时限额=limit×副本数）| redis 跨实例共享计数。
# 启用 redis 需 Redis 可达（THROTTLE_STORAGE=redis 时应用启动即连接）
THROTTLE_STORAGE=memory

# ---------- PostgreSQL / TypeORM ----------
# docker-compose.yml（dev）默认值：nest_app / pg_dev_password / nest_dev
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nest_app
# 开发默认密码与 docker-compose.yml 的 ${DB_PASSWORD:-pg_dev_password} 一致——
# 空值会导致"容器用默认密码启动、应用连不上"（快速开始失败）；
# 生产必须由部署平台/环境注入覆盖，且含 $ 的密码注意转义规则（见 app.module 注释）
DB_PASSWORD=pg_dev_password
DB_DATABASE=nest_dev
# 托管数据库常要求 TLS：true 时以 ssl 连接，默认校验服务端证书链
DB_SSL=false
# TLS 是否校验证书链：默认 true（安全）；false 仅限本地/内网实验并显式配置，
# 指向外部托管数据库时不校验证书等于接受任意证书（MITM 风险）
DB_SSL_REJECT_UNAUTHORIZED=true
# CA 证书文件路径（PEM）：指向自签/私有 CA 托管的数据库时填写，
# 提供后强制 rejectUnauthorized=true 并校验服务端证书链
# DB_SSL_CA=/path/to/ca.pem
# 仅原型阶段可 true；生产环境设为 true 会直接启动失败（env.validation.ts 强制）
DB_SYNCHRONIZE=false
# SQL 日志：false | true/all | 逗号分隔类别（query,schema,error,warn,info,log,migration）
DB_LOGGING=error
# 连接池（pg）：上限/最小空闲/空闲回收毫秒/取连接超时毫秒
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000
# 驱动级查询超时（毫秒，0=禁用）：服务端先终止（statement_timeout）再客户端兜底
# （query_timeout）——pg 的 query_timeout 只本地回调失败、不取消服务端查询；
# 应用与 migration 建议不同：CLI 迁移（data-source.ts）显式置 0，避免长 DDL 被中断
DB_QUERY_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=4000

# ---------- Redis（缓存 + 限速存储） ----------
# docker-compose.yml（dev）默认值：redis_dev_password
REDIS_HOST=localhost
REDIS_PORT=6379
# 开发默认密码与 docker-compose 的 ${REDIS_PASSWORD:-redis_dev_password} 一致（同上）；
# 生产必须非空（env.validation.ts 强制）
REDIS_PASSWORD=redis_dev_password
# 逻辑库编号 0-15，不同用途建议分库
REDIS_DB=0
# 键前缀（必须以 : 结尾），用于同实例多应用隔离
REDIS_KEY_PREFIX=nest:
# 单条命令超时（毫秒，0=禁用），防依赖假死时命令无限挂起（与探针 2s 超时分层兜底）
REDIS_COMMAND_TIMEOUT_MS=5000

# ---------- JWT（认证模块） ----------
# 签名密钥（>=16 字符）：开发可用示例值，生产必须显式配置强随机值
# （env.validation.ts 安全策略 7：生产缺省会启动失败）生成方式：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me
# 访问令牌有效期（秒）：无状态不存库，短 TTL 缩小泄露窗口
JWT_ACCESS_TTL_SECONDS=900
# 刷新令牌有效期（秒）：DB 存哈希，撤销/过期即失效
JWT_REFRESH_TTL_SECONDS=604800

# ---------- 定时清理（cleanup 模块） ----------
# 每日 03:00 任务删除过期超保留期的行；审计合规要求通常更长，按需调大
CLEANUP_REFRESH_TOKEN_RETENTION_DAYS=30
CLEANUP_AUDIT_RETENTION_DAYS=180
