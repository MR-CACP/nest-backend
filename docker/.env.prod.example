# 生产 compose 凭证模板：复制为 docker/.env.prod（已被 .gitignore 排除）后填入真实值。
# docker/.env.prod 同时供 compose 的 ${VAR:?} 插值与镜像外注入使用——凭证不进镜像层。

# ---------- PostgreSQL（compose 内网服务，不对宿主暴露端口） ----------
# 库名须匹配 ^[a-zA-Z_][a-zA-Z0-9_]*$
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=nest_prod

# ---------- Redis ----------
REDIS_PASSWORD=change_me_redis_password
REDIS_KEY_PREFIX=nest:

# ---------- JWT（认证模块，生产必填） ----------
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_random_secret_at_least_16_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ---------- 应用 ----------
APP_HOST_PORT=3000
API_PREFIX=api
# 反向代理层数；无代理直连设 false
TRUST_PROXY=1
LOG_LEVEL=info
# 逗号分隔白名单，生产不建议 *（且 credentials=true 时 * 会被启动校验拒绝）；
# 生产必填（env.validation.ts 安全策略 6：缺省会被拒绝启动）
CORS_ORIGIN=https://app.example.com
CORS_CREDENTIALS=false
THROTTLE_TTL=60
THROTTLE_LIMIT=100
DB_POOL_MAX=10
DB_POOL_MIN=2
# 应用查询超时（毫秒）：服务端先终止（statement_timeout）再客户端兜底（query_timeout）。
# pg 的 query_timeout 只本地回调失败、不取消服务端查询，故 statement < query。
# 注意：migrate 服务显式置 0（不受此值约束），长 DDL/数据迁移不会被中断。
DB_QUERY_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=4000
# Redis 单条命令超时（毫秒，0=禁用）
REDIS_COMMAND_TIMEOUT_MS=5000

# ---------- 迁移专项（仅 migrate 服务/CLI 使用，不进应用运行时） ----------
# 锁等待超时（毫秒，0=禁用）：迁移不设 statement/query 超时（长 DDL 不应被中断），
# 但锁等待必须有限，防止迁移死锁时永久挂起
DB_MIGRATION_LOCK_TIMEOUT_MS=10000
# 整体部署超时（秒）：migrate 命令由 timeout 包装，超过即失败并告警，
# 避免异常 SQL 让部署无限等待
DB_MIGRATION_TIMEOUT_SECONDS=600
